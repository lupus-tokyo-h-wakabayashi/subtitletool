[32m+[m[32mfrom pathlib import Path[m
[32m+[m
[32m+[m[32mfrom lib.ollama import generate[m
[32m+[m[32mfrom lib.srt import ([m
[32m+[m[32m    SrtBlock,[m
[32m+[m[32m    apply_translations,[m
[32m+[m[32m    chunk_blocks,[m
[32m+[m[32m    extract_text_lines,[m
[32m+[m[32m    parse_numbered_translation,[m
[32m+[m[32m    parse_srt,[m
[32m+[m[32m    write_structured_srt,[m
[32m+[m[32m)[m
[32m+[m
[32m+[m[32mMODEL = "qwen3:14b"[m
[32m+[m[32mCHUNK_SIZE = 30[m
[32m+[m
[32m+[m
[32m+[m[32mdef build_prompt(text_lines: str, count: int) -> str:[m
[32m+[m[32m    return f"""You are a professional subtitle translator.[m
[32m+[m
[32m+[m[32mTranslate the following English subtitle lines into natural Japanese.[m
[32m+[m
[32m+[m[32mRules:[m
[32m+[m[32m- Output exactly {count} lines.[m
[32m+[m[32m- Keep the same numbering format: "1. ...", "2. ...".[m
[32m+[m[32m- Do not output timestamps.[m
[32m+[m[32m- Do not output SRT blocks.[m
[32m+[m[32m- Do not add explanations.[m
[32m+[m[32m- Translate only the text after the number.[m
[32m+[m[32m- Keep each line short and natural for subtitles.[m
[32m+[m[32m- If a line has only symbols or no meaningful text, copy it as-is.[m
[32m+[m[32m- Never output "blank" or "（空白）".[m
[32m+[m[32m- Keep names consistent:[m
[32m+[m[32m  Stargate=スターゲイト[m
[32m+[m[32m  Destiny=デスティニー[m
[32m+[m[32m  Colonel Young=ヤング大佐[m
[32m+[m[32m  Eli=イーライ[m
[32m+[m[32m  Rush=ラッシュ博士[m
[32m+[m[32m  Chloe=クロエ[m
[32m+[m[32m  Scott=スコット[m
[32m+[m[32m  Lieutenant=中尉[m
[32m+[m[32m  Senator=上院議員[m
[32m+[m
[32m+[m[32mInput:[m
[32m+[m[32m{text_lines}[m
[32m+[m[32m"""[m
[32m+[m
[32m+[m
[32m+[m[32mdef translate_chunk(blocks: list[SrtBlock], model: str) -> list[str]:[m
[32m+[m[32m    text_lines = extract_text_lines(blocks)[m
[32m+[m[32m    prompt = build_prompt(text_lines, len(blocks))[m
[32m+[m
[32m+[m[32m    response = generate(prompt, model=model)[m
[32m+[m[32m    translations = parse_numbered_translation(response, len(blocks))[m
[32m+[m
[32m+[m[32m    # 不足がある場合は元文で補完[m
[32m+[m[32m    fixed = [][m
[32m+[m
[32m+[m[32m    for block, translated in zip(blocks, translations):[m
[32m+[m[32m        if translated.strip():[m
[32m+[m[32m            fixed.append(translated.strip())[m
[32m+[m[32m        else:[m
[32m+[m[32m            fixed.append(block.text)[m
[32m+[m
[32m+[m[32m    return fixed[m
[32m+[m
[32m+[m
[32m+[m[32mdef translate_srt([m
[32m+[m[32m    input_srt: str | Path,[m
[32m+[m[32m    output_srt: str | Path,[m
[32m+[m[32m    model: str = MODEL,[m
[32m+[m[32m    chunk_size: int = CHUNK_SIZE,[m
[32m+[m[32m) -> Path:[m
[32m+[m[32m    input_srt = Path(input_srt).expanduser().resolve()[m
[32m+[m[32m    output_srt = Path(output_srt).expanduser().resolve()[m
[32m+[m
[32m+[m[32m    if not input_srt.exists():[m
[32m+[m[32m        raise FileNotFoundError(f"SRT not found: {input_srt}")[m
[32m+[m
[32m+[m[32m    if output_srt.exists():[m
[32m+[m[32m        print(f"Skip Translate: {output_srt}")[m
[32m+[m[32m        return output_srt[m
[32m+[m
[32m+[m[32m    source_blocks = parse_srt(input_srt)[m
[32m+[m
[32m+[m[32m    translated_all: list[SrtBlock] = [][m
[32m+[m[32m    total = len(source_blocks)[m
[32m+[m[32m    done = 0[m
[32m+[m
[32m+[m[32m    for chunk in chunk_blocks(source_blocks, chunk_size):[m
[32m+[m[32m        print(f"Translating {done + 1}-{done + len(chunk)} / {total} ...")[m
[32m+[m
[32m+[m[32m        translated_texts = translate_chunk(chunk, model)[m
[32m+[m[32m        translated_blocks = apply_translations(chunk, translated_texts)[m
[32m+[m
[32m+[m[32m        translated_all.extend(translated_blocks)[m
[32m+[m[32m        done += len(chunk)[m
[32m+[m
[32m+[m[32m        write_structured_srt(output_srt, translated_all)[m
[32m+[m
[32m+[m[32m    return output_srt[m
