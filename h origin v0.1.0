[32m+[m[32m#!/usr/bin/env python3[m
[32m+[m[32mimport json[m
[32m+[m[32mimport subprocess[m
[32m+[m[32mfrom pathlib import Path[m
[32m+[m
[32m+[m
[32m+[m[32mdef probe(input_path: str | Path) -> dict:[m
[32m+[m[32m    result = subprocess.run([m
[32m+[m[32m        [[m
[32m+[m[32m            "ffprobe",[m
[32m+[m[32m            "-v", "error",[m
[32m+[m[32m            "-print_format", "json",[m
[32m+[m[32m            "-show_streams",[m
[32m+[m[32m            "-show_format",[m
[32m+[m[32m            str(input_path),[m
[32m+[m[32m        ],[m
[32m+[m[32m        text=True,[m
[32m+[m[32m        stdout=subprocess.PIPE,[m
[32m+[m[32m        stderr=subprocess.PIPE,[m
[32m+[m[32m        check=True,[m
[32m+[m[32m    )[m
[32m+[m
[32m+[m[32m    return json.loads(result.stdout)[m
[32m+[m
[32m+[m
[32m+[m[32mdef streams(input_path: str | Path) -> list[dict]:[m
[32m+[m[32m    return probe(input_path).get("streams", [])[m
[32m+[m
[32m+[m
[32m+[m[32mdef subtitle_streams(input_path: str | Path) -> list[dict]:[m
[32m+[m[32m    return [[m
[32m+[m[32m        stream for stream in streams(input_path)[m
[32m+[m[32m        if stream.get("codec_type") == "subtitle"[m
[32m+[m[32m    ][m
[32m+[m
[32m+[m
[32m+[m[32mdef audio_streams(input_path: str | Path) -> list[dict]:[m
[32m+[m[32m    return [[m
[32m+[m[32m        stream for stream in streams(input_path)[m
[32m+[m[32m        if stream.get("codec_type") == "audio"[m
[32m+[m[32m    ][m
[32m+[m
[32m+[m
[32m+[m[32mdef video_streams(input_path: str | Path) -> list[dict]:[m
[32m+[m[32m    return [[m
[32m+[m[32m        stream for stream in streams(input_path)[m
[32m+[m[32m        if stream.get("codec_type") == "video"[m
[32m+[m[32m    ][m
[32m+[m
[32m+[m
[32m+[m[32mdef find_best_english_pgs_subtitle(input_path: str | Path) -> dict | None:[m
[32m+[m[32m    candidates = [][m
[32m+[m
[32m+[m[32m    for stream in subtitle_streams(input_path):[m
[32m+[m[32m        tags = stream.get("tags", {})[m
[32m+[m[32m        language = tags.get("language", "")[m
[32m+[m[32m        codec = stream.get("codec_name", "")[m
[32m+[m
[32m+[m[32m        if language == "eng" and codec in ["hdmv_pgs_subtitle", "pgssub"]:[m
[32m+[m[32m            candidates.append(stream)[m
[32m+[m
[32m+[m[32m    if not candidates:[m
[32m+[m[32m        return None[m
[32m+[m
[32m+[m[32m    # 通常字幕を優先。強制字幕はフレーム数が少ないことが多いので避ける。[m
[32m+[m[32m    candidates.sort([m
[32m+[m[32m        key=lambda s: int(s.get("nb_frames") or 0),[m
[32m+[m[32m        reverse=True,[m
[32m+[m[32m    )[m
[32m+[m
[32m+[m[32m    return candidates[0][m
[32m+[m
[32m+[m
[32m+[m[32mdef subtitle_count(input_path: str | Path) -> int:[m
[32m+[m[32m    return len(subtitle_streams(input_path))[m
