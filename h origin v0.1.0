[32m+[m[32m#!/usr/bin/env python3[m
[32m+[m[32mimport json[m
[32m+[m[32mimport re[m
[32m+[m[32mimport sys[m
[32m+[m[32mimport urllib.request[m
[32m+[m[32mfrom pathlib import Path[m
[32m+[m
[32m+[m[32mMODEL = "qwen3:14b"[m
[32m+[m[32mCHUNK_SIZE = 40[m
[32m+[m
[32m+[m
[32m+[m[32mdef get_ollama_url():[m
[32m+[m[32m    import subprocess[m
[32m+[m[32m    host = subprocess.check_output([m
[32m+[m[32m        "ip route | awk '/default/ {print $3}'",[m
[32m+[m[32m        shell=True,[m
[32m+[m[32m        text=True[m
[32m+[m[32m    ).strip()[m
[32m+[m[32m    return f"http://{host}:11434/api/generate"[m
[32m+[m
[32m+[m
[32m+[m[32mdef split_srt_blocks(text):[m
[32m+[m[32m    return re.split(r"\n\s*\n", text.strip())[m
[32m+[m
[32m+[m
[32m+[m[32mdef chunk_blocks(blocks, size):[m
[32m+[m[32m    for i in range(0, len(blocks), size):[m
[32m+[m[32m        yield blocks[i:i + size][m
[32m+[m
[32m+[m
[32m+[m[32mdef build_prompt(srt_chunk):[m
[32m+[m[32m    return f"""You are a professional subtitle translator.[m
[32m+[m
[32m+[m[32mTranslate this SRT from English to natural Japanese.[m
[32m+[m
[32m+[m[32mRules:[m
[32m+[m[32m- Preserve subtitle numbers exactly.[m
[32m+[m[32m- Preserve timestamps exactly.[m
[32m+[m[32m- Preserve SRT block structure.[m
[32m+[m[32m- Translate only dialogue text.[m
[32m+[m[32m- Output ONLY valid SRT.[m
[32m+[m[32m- Do not add explanations.[m
[32m+[m[32m- Use natural spoken Japanese.[m
[32m+[m[32m- Keep names consistent:[m
[32m+[m[32m  Stargate=スターゲイト[m
[32m+[m[32m  Destiny=デスティニー[m
[32m+[m[32m  Colonel Young=ヤング大佐[m
[32m+[m[32m  Eli=イーライ[m
[32m+[m[32m  Rush=ラッシュ博士[m
[32m+[m[32m  Chloe=クロエ[m
[32m+[m[32m  Scott=スコット[m
[32m+[m[32m  Lieutenant=中尉[m
[32m+[m[32m  Senator=上院議員[m
[32m+[m
[32m+[m[32mSRT:[m
[32m+[m[32m{srt_chunk}[m
[32m+[m[32m"""[m
[32m+[m
[32m+[m
[32m+[m[32mdef call_ollama(prompt):[m
[32m+[m[32m    data = json.dumps({[m
[32m+[m[32m        "model": MODEL,[m
[32m+[m[32m        "prompt": prompt,[m
[32m+[m[32m        "stream": False,[m
[32m+[m[32m        "options": {[m
[32m+[m[32m            "temperature": 0.2,[m
[32m+[m[32m            "top_p": 0.9[m
[32m+[m[32m        }[m
[32m+[m[32m    }).encode("utf-8")[m
[32m+[m
[32m+[m[32m    req = urllib.request.Request([m
[32m+[m[32m        get_ollama_url(),[m
[32m+[m[32m        data=data,[m
[32m+[m[32m        headers={"Content-Type": "application/json"},[m
[32m+[m[32m        method="POST",[m
[32m+[m[32m    )[m
[32m+[m
[32m+[m[32m    with urllib.request.urlopen(req, timeout=600) as res:[m
[32m+[m[32m        body = json.loads(res.read().decode("utf-8"))[m
[32m+[m[32m        return body["response"].strip()[m
[32m+[m
[32m+[m
[32m+[m[32mdef main():[m
[32m+[m[32m    if len(sys.argv) < 3:[m
[32m+[m[32m        print("Usage: subtitletool translate input.srt output.srt")[m
[32m+[m[32m        sys.exit(1)[m
[32m+[m
[32m+[m[32m    input_path = Path(sys.argv[1]).expanduser()[m
[32m+[m[32m    output_path = Path(sys.argv[2]).expanduser()[m
[32m+[m
[32m+[m[32m    text = input_path.read_text(encoding="utf-8", errors="replace")[m
[32m+[m[32m    blocks = split_srt_blocks(text)[m
[32m+[m
[32m+[m[32m    translated_chunks = [][m
[32m+[m
[32m+[m[32m    total = len(blocks)[m
[32m+[m[32m    done = 0[m
[32m+[m
[32m+[m[32m    for chunk in chunk_blocks(blocks, CHUNK_SIZE):[m
[32m+[m[32m        srt_chunk = "\n\n".join(chunk)[m
[32m+[m[32m        prompt = build_prompt(srt_chunk)[m
[32m+[m
[32m+[m[32m        print(f"Translating {done + 1}-{done + len(chunk)} / {total} ...")[m
[32m+[m[32m        translated = call_ollama(prompt)[m
[32m+[m
[32m+[m[32m        translated_chunks.append(translated)[m
[32m+[m[32m        done += len(chunk)[m
[32m+[m
[32m+[m[32m        output_path.write_text([m
[32m+[m[32m            "\n\n".join(translated_chunks).strip() + "\n",[m
[32m+[m[32m            encoding="utf-8"[m
[32m+[m[32m        )[m
[32m+[m
[32m+[m[32m    print(f"Done: {output_path}")[m
[32m+[m
[32m+[m
[32m+[m[32mif __name__ == "__main__":[m
[32m+[m[32m    main()[m
