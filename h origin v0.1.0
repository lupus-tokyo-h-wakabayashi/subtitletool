[32m+[m[32m#!/usr/bin/env python3[m
[32m+[m[32mimport re[m
[32m+[m[32mfrom dataclasses import dataclass[m
[32m+[m[32mfrom pathlib import Path[m
[32m+[m
[32m+[m
[32m+[m[32m@dataclass[m
[32m+[m[32mclass SrtBlock:[m
[32m+[m[32m    number: str[m
[32m+[m[32m    timestamp: str[m
[32m+[m[32m    text: str[m
[32m+[m
[32m+[m
[32m+[m[32mdef parse_srt(path: str | Path) -> list[SrtBlock]:[m
[32m+[m[32m    path = Path(path).expanduser().resolve()[m
[32m+[m[32m    raw = path.read_text(encoding="utf-8", errors="replace").strip()[m
[32m+[m
[32m+[m[32m    blocks = [][m
[32m+[m
[32m+[m[32m    for chunk in re.split(r"\n\s*\n", raw):[m
[32m+[m[32m        lines = [line.rstrip() for line in chunk.splitlines()][m
[32m+[m
[32m+[m[32m        if len(lines) < 2:[m
[32m+[m[32m            continue[m
[32m+[m
[32m+[m[32m        number = lines[0].strip()[m
[32m+[m[32m        timestamp = lines[1].strip()[m
[32m+[m[32m        text = "\n".join(lines[2:]).strip()[m
[32m+[m
[32m+[m[32m        if "-->" not in timestamp:[m
[32m+[m[32m            continue[m
[32m+[m
[32m+[m[32m        blocks.append(SrtBlock(number=number, timestamp=timestamp, text=text))[m
[32m+[m
[32m+[m[32m    return blocks[m
[32m+[m
[32m+[m
[32m+[m[32mdef write_structured_srt(path: str | Path, blocks: list[SrtBlock]) -> None:[m
[32m+[m[32m    path = Path(path).expanduser().resolve()[m
[32m+[m
[32m+[m[32m    out = [][m
[32m+[m
[32m+[m[32m    for block in blocks:[m
[32m+[m[32m        text = block.text.strip()[m
[32m+[m
[32m+[m[32m        if not text:[m
[32m+[m[32m            text = block.text[m
[32m+[m
[32m+[m[32m        out.append(f"{block.number}\n{block.timestamp}\n{text}")[m
[32m+[m
[32m+[m[32m    path.write_text("\n\n".join(out).strip() + "\n", encoding="utf-8")[m
[32m+[m
[32m+[m
[32m+[m[32mdef chunk_blocks(blocks: list[SrtBlock], size: int):[m
[32m+[m[32m    for i in range(0, len(blocks), size):[m
[32m+[m[32m        yield blocks[i:i + size][m
[32m+[m
[32m+[m
[32m+[m[32mdef default_ja_path(input_srt: str | Path) -> Path:[m
[32m+[m[32m    input_srt = Path(input_srt).expanduser().resolve()[m
[32m+[m[32m    name = input_srt.name[m
[32m+[m
[32m+[m[32m    if name.endswith(".eng.srt"):[m
[32m+[m[32m        return input_srt.with_name(name.replace(".eng.srt", ".ja.srt"))[m
[32m+[m
[32m+[m[32m    if name.endswith(".srt"):[m
[32m+[m[32m        return input_srt.with_name(name.replace(".srt", ".ja.srt"))[m
[32m+[m
[32m+[m[32m    return input_srt.with_suffix(".ja.srt")[m
[32m+[m
[32m+[m
[32m+[m[32mdef extract_text_lines(blocks: list[SrtBlock]) -> str:[m
[32m+[m[32m    lines = [][m
[32m+[m
[32m+[m[32m    for i, block in enumerate(blocks, start=1):[m
[32m+[m[32m        text = block.text.replace("\n", " / ").strip()[m
[32m+[m[32m        lines.append(f"{i}. {text}")[m
[32m+[m
[32m+[m[32m    return "\n".join(lines)[m
[32m+[m
[32m+[m
[32m+[m[32mdef parse_numbered_translation(text: str, expected_count: int) -> list[str]:[m
[32m+[m[32m    text = text.strip()[m
[32m+[m[32m    text = re.sub(r"^```(?:text)?\s*", "", text)[m
[32m+[m[32m    text = re.sub(r"\s*```$", "", text)[m
[32m+[m
[32m+[m[32m    result = [""] * expected_count[m
[32m+[m
[32m+[m[32m    pattern = re.compile([m
[32m+[m[32m        r"^\s*(\d+)[\.\)：:)、]\s*(.*)$"[m
[32m+[m[32m    )[m
[32m+[m
[32m+[m[32m    for line in text.splitlines():[m
[32m+[m[32m        line = line.strip()[m
[32m+[m[32m        match = pattern.match(line)[m
[32m+[m
[32m+[m[32m        if not match:[m
[32m+[m[32m            continue[m
[32m+[m
[32m+[m[32m        idx = int(match.group(1)) - 1[m
[32m+[m[32m        value = match.group(2).strip()[m
[32m+[m
[32m+[m[32m        if 0 <= idx < expected_count:[m
[32m+[m[32m            result[idx] = value[m
[32m+[m
[32m+[m[32m    return result[m
[32m+[m
[32m+[m
[32m+[m[32mdef apply_translations([m
[32m+[m[32m    source_blocks: list[SrtBlock],[m
[32m+[m[32m    translations: list[str],[m
[32m+[m[32m) -> list[SrtBlock]:[m
[32m+[m[32m    output = [][m
[32m+[m
[32m+[m[32m    for block, translated in zip(source_blocks, translations):[m
[32m+[m[32m        text = translated.strip()[m
[32m+[m
[32m+[m[32m        # 空・空白プレースホルダなら元文を残す[m
[32m+[m[32m        if not text or text in ["（空白）", "(blank)", "blank", "空白"]:[m
[32m+[m[32m            text = block.text[m
[32m+[m
[32m+[m[32m        output.append([m
[32m+[m[32m            SrtBlock([m
[32m+[m[32m                number=block.number,[m
[32m+[m[32m                timestamp=block.timestamp,[m
[32m+[m[32m                text=text,[m
[32m+[m[32m            )[m
[32m+[m[32m        )[m
[32m+[m
[32m+[m[32m    return output[m
